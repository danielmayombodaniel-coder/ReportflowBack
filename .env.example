# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/plume_noire

# JWT secret used to sign admin tokens (keep secret in production)
JWT_SECRET=your_jwt_secret_here

# Initial admin seed (required only when running npm run seed:admin)
ADMIN_TELEPHONE=
ADMIN_PASSWORD=

# Optional: server port
PORT=5000

# Max upload size for files (in MB)
MAX_UPLOAD_SIZE_MB=50

# CORS configuration for production
FRONTEND_URL=https://reportflow-front.onrender.com